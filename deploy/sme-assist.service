[Unit]
Description=SME-Assist FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sme-assist
EnvironmentFile=/home/ubuntu/sme-assist/.env
ExecStart=/home/ubuntu/sme-assist/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target